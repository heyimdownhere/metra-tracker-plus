# Copy to .env and edit. Used by docker-compose.yml; all values are optional.
# .env is git-ignored, so your API key never ends up in the repo.

# Your Metra GTFS-Realtime API key. Leave empty to run schedule-only.
METRA_API_TOKEN=

# Port you open in the browser: http://<server>:WEB_PORT
WEB_PORT=8080

# Where the schedule cache, history and settings are kept on the host.
APPDATA=/mnt/user/appdata/metra-tracker

# Time zone for logs (the app itself always uses Metra's Chicago time).
TZ=America/Chicago

# Default home station (id like EVANSTON, or a name like "Evanston (Davis St.)").
# Used until someone taps "Set as home" in the app. Station ids: /api/stations
HOME_STATION=
HOME_DESTINATION=

# Optional work station. On workdays the app opens on home -> work until
# COMMUTE_SWITCH_TIME, then work -> home. All three can also be set in the app.
WORK_STATION=
COMMUTE_SWITCH_TIME=12:00
WORK_DAYS=mon-fri

# Days of delay history to keep (0 turns history off).
HISTORY_DAYS=365

# Seconds between realtime polls. Minimum 30 (Metra's rule).
REALTIME_INTERVAL=30

# Seconds between checks for a new Metra schedule (min 60).
STATIC_CHECK_INTERVAL=3600
# Re-download the full schedule this often, even if unchanged (0 = never)
STATIC_FULL_REFRESH_DAYS=7

# Self-hosted map: the server downloads a Chicago-area OpenStreetMap extract once
# (from Protomaps) and serves it, so phones never load tiles from outside.
MAP_DOWNLOAD=true
# Most detailed level to download (8-15); 14 is roughly a quarter of the size.
MAP_MAX_ZOOM=15
MAP_REFRESH_DAYS=30
# Advanced: extract from a specific .pmtiles URL instead of the latest Protomaps build.
# MAP_SOURCE=
# Advanced: area to download, min_lon,min_lat,max_lon,max_lat (default: all of Metra).
# MAP_BBOX=-88.75,41.30,-87.40,42.70

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Advanced: port inside the container. Only change if 8080 clashes with
# something else in the same network namespace (e.g. host networking).
PORT=8080

# Advanced: build locally instead of pulling the published image:
#   IMAGE=metra-tracker-plus:latest  and run  docker compose up -d --build
